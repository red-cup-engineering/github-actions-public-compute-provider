#lang rmn/v2
(map
  ("type" "GitHubActionsPublicComputeProviderLaw")
  ("version" 2)
  ("precondition" "GitHub independently reports the exact runner repository and target repository public; the runner Actions policy is enabled; the target is one exact 40-hex commit; the optional unified diff is at most 49152 decoded bytes; the installed workflow digest equals the admitted local carrier; and the workflow tag belongs to the exact published immutable GitHub release.")
  ("operation" "Dispatch one workflow_dispatch job on ubuntu-latest with permissions empty, no secrets, an execution ceiling of fifteen minutes, no artifacts or caches, an anonymous exact-commit fetch, optional checked git-apply, and one provider-selected test harness.")
